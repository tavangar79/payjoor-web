# Copy to .env and fill in for `npm start -w web`. Never commit real values (PRD §12).

NODE_ENV=development
PORT=3001
# Backend base URL; the data-deletion status page reads GET /api/deletion-status from it
API_URL=http://localhost:3000
# Shown on every legal page (§7.3)
CONTACT_EMAIL=
# The bot's Instagram handle (without @) and the company named in the privacy policy (§7.3)
SITE_INSTAGRAM_HANDLE=
COMPANY_NAME=
